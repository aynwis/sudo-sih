# Copy this file to `.env` and fill in real values. Never commit `.env`.

# The FULL contents of your GCP service account key JSON, as a single line.
# e.g. GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}
GEE_SERVICE_ACCOUNT_JSON=

# GCP project id tied to the service account above.
GEE_PROJECT_ID=

# Path to the trained model bundle.
MODEL_PATH=models/manganese_xgboost_models.pkl
